VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=

# Secrets de servidor/Edge Function. Nunca use como VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# IA roda apenas no backend (Supabase Edge Function/serverless).
# Configure como secret, nunca como VITE_*:
# supabase secrets set OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY=

# Base URL for API endpoints when the frontend is opened from another device.
# Leave empty to use the same origin.
VITE_API_URL=

# Mercado Pago checkout
VITE_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PRICE_ESSENCIAL=39.90
MP_PRICE_PRO=298.80
MP_WEBHOOK_URL=
APP_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
PAYMENT_PENDING_URL=

# Checkout legado serverless. Deixe vazio quando usar Supabase Edge Functions.
# Se preencher, configure MP_WEBHOOK_URL=https://.../functions/v1/webhook-mercadopago
VITE_PAYMENT_CHECKOUT_ENDPOINT=
VITE_CHECKOUT_ESSENCIAL_URL=
VITE_CHECKOUT_PRO_URL=
